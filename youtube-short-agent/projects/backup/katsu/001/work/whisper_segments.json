[
  {
    "start": 0.0,
    "end": 3.36,
    "text": "考えすぎて動けなくなることがあります。"
  },
  {
    "start": 3.84,
    "end": 6.24,
    "text": "仕事で新しいことを任されたとき、"
  },
  {
    "start": 6.48,
    "end": 10.32,
    "text": "人間関係で何かを伝えなければいけないとき、"
  },
  {
    "start": 10.62,
    "end": 12.82,
    "text": "SNSで発信しようとして、"
  },
  {
    "start": 13.06,
    "end": 15.38,
    "text": "これで大丈夫だろうかと迷うとき、"
  },
  {
    "start": 15.62,
    "end": 17.36,
    "text": "準備をしているはずなのに、"
  },
  {
    "start": 17.5,
    "end": 20.26,
    "text": "頭の中では次々と不安が増えていく。"
  },
  {
    "start": 20.5,
    "end": 22.34,
    "text": "もし失敗したらどうしよう?"
  },
  {
    "start": 22.5,
    "end": 24.18,
    "text": "変に思われたらどうしよう?"
  },
  {
    "start": 24.48,
    "end": 27.08,
    "text": "もっと調べてからの方がいいんじゃないか。"
  },
  {
    "start": 27.24,
    "end": 28.78,
    "text": "そうしているうちに、"
  },
  {
    "start": 28.78,
    "end": 30.7,
    "text": "一番大事な一歩が、"
  },
  {
    "start": 30.86,
    "end": 33.08,
    "text": "どんどん遠くなってしまうことがあります。"
  },
  {
    "start": 33.6,
    "end": 35.58,
    "text": "そんなときに思い出したいのが、"
  },
  {
    "start": 35.78,
    "end": 37.5,
    "text": "カツ回収のこの言葉です。"
  },
  {
    "start": 37.62,
    "end": 39.5,
    "text": "時と場合に応じて、"
  },
  {
    "start": 39.6,
    "end": 42.06,
    "text": "それぞれの資料分別はできるものだ。"
  },
  {
    "start": 42.62,
    "end": 45.34,
    "text": "これは、何も考えずに動けばいい、"
  },
  {
    "start": 45.46,
    "end": 46.84,
    "text": "という意味ではありません。"
  },
  {
    "start": 47.14,
    "end": 49.86,
    "text": "むしろ、人はその場に立ったとき、"
  },
  {
    "start": 50.04,
    "end": 51.96,
    "text": "そのときの状況に合わせて、"
  },
  {
    "start": 52.24,
    "end": 54.5,
    "text": "ちゃんと考える力を持っている、"
  },
  {
    "start": 54.76,
    "end": 55.76,
    "text": "という言葉です。"
  },
  {
    "start": 56.02,
    "end": 57.46,
    "text": "私たちはよく、"
  },
  {
    "start": 57.46,
    "end": 60.36,
    "text": "未来のすべてを先に決めておこうとします。"
  },
  {
    "start": 60.74,
    "end": 62.16,
    "text": "相手がこう言ったら、"
  },
  {
    "start": 62.2,
    "end": 63.1,
    "text": "こう返そう。"
  },
  {
    "start": 63.3,
    "end": 64.76,
    "text": "うまくいかなかったら、"
  },
  {
    "start": 64.88,
    "end": 65.64,
    "text": "こうしよう。"
  },
  {
    "start": 65.86,
    "end": 67.04,
    "text": "批判されたら、"
  },
  {
    "start": 67.28,
    "end": 67.88,
    "text": "どうしよう?"
  },
  {
    "start": 68.12,
    "end": 69.12,
    "text": "もちろん、"
  },
  {
    "start": 69.18,
    "end": 70.54,
    "text": "準備は大切です。"
  },
  {
    "start": 70.78,
    "end": 71.08,
    "text": "でも、"
  },
  {
    "start": 71.66,
    "end": 74.12,
    "text": "まだ起きていないことを全部想像して、"
  },
  {
    "start": 74.48,
    "end": 77.1,
    "text": "全部に答えを用意しようとすると、"
  },
  {
    "start": 77.22,
    "end": 79.6,
    "text": "心の力が先に疲れてしまいます。"
  },
  {
    "start": 79.9,
    "end": 81.38,
    "text": "実際の現場では、"
  },
  {
    "start": 81.76,
    "end": 84.68,
    "text": "予定通りに進まないことの方が多いものです。"
  },
  {
    "start": 84.9,
    "end": 86.28,
    "text": "相手の反応も、"
  },
  {
    "start": 86.28,
    "end": 88.06,
    "text": "その日の空気も、"
  },
  {
    "start": 88.28,
    "end": 89.76,
    "text": "自分の気持ちも、"
  },
  {
    "start": 89.94,
    "end": 91.42,
    "text": "やってみるまでは借りません。"
  },
  {
    "start": 91.86,
    "end": 93.68,
    "text": "だからこそ、かつ回収は、"
  },
  {
    "start": 93.8,
    "end": 96.22,
    "text": "そのときその場で考えればいいことまで、"
  },
  {
    "start": 96.78,
    "end": 98.56,
    "text": "前もって心配しすぎるな、"
  },
  {
    "start": 98.9,
    "end": 100.68,
    "text": "と伝えているのかもしれません。"
  },
  {
    "start": 101.12,
    "end": 102.54,
    "text": "新しい仕事も、"
  },
  {
    "start": 102.78,
    "end": 106.02,
    "text": "最初から完璧な計画を作る必要はありません。"
  },
  {
    "start": 106.34,
    "end": 107.86,
    "text": "まず小さく始めてみる。"
  },
  {
    "start": 108.14,
    "end": 109.12,
    "text": "反応を見る。"
  },
  {
    "start": 109.42,
    "end": 110.58,
    "text": "違っていたら直す。"
  },
  {
    "start": 110.94,
    "end": 112.02,
    "text": "その方が、"
  },
  {
    "start": 112.12,
    "end": 114.58,
    "text": "頭の中だけで悩み続けるより、"
  },
  {
    "start": 114.58,
    "end": 116.62,
    "text": "ずっと現実に近づけます。"
  },
  {
    "start": 117.0,
    "end": 118.76,
    "text": "人間関係でも同じです。"
  },
  {
    "start": 119.02,
    "end": 121.36,
    "text": "言い方を何十通りも考えて、"
  },
  {
    "start": 121.62,
    "end": 123.86,
    "text": "結局何も言えなくなることがあります。"
  },
  {
    "start": 124.22,
    "end": 124.54,
    "text": "でも、"
  },
  {
    "start": 125.24,
    "end": 127.02,
    "text": "実際に向き合ってみると、"
  },
  {
    "start": 127.2,
    "end": 129.44,
    "text": "その場の表情や声の調子から、"
  },
  {
    "start": 129.8,
    "end": 131.96,
    "text": "自然に言葉が選べることもあります。"
  },
  {
    "start": 132.26,
    "end": 135.44,
    "text": "発信も、挑戦も、学びも、"
  },
  {
    "start": 135.58,
    "end": 138.5,
    "text": "全部を整えてから始めようとすると、"
  },
  {
    "start": 138.58,
    "end": 139.94,
    "text": "いつまでも始まりません。"
  },
  {
    "start": 140.3,
    "end": 141.26,
    "text": "必要なのは、"
  },
  {
    "start": 141.8,
    "end": 143.12,
    "text": "完璧な準備ではなく、"
  },
  {
    "start": 143.12,
    "end": 145.76,
    "text": "動きながら考える予白です。"
  },
  {
    "start": 146.08,
    "end": 146.9,
    "text": "大事なのは、"
  },
  {
    "start": 147.46,
    "end": 148.92,
    "text": "考えないことではありません。"
  },
  {
    "start": 149.4,
    "end": 150.64,
    "text": "考えすぎて、"
  },
  {
    "start": 150.68,
    "end": 153.36,
    "text": "自分の判断力まで疑わないことです。"
  },
  {
    "start": 153.7,
    "end": 155.04,
    "text": "未来の自分は、"
  },
  {
    "start": 155.16,
    "end": 157.38,
    "text": "今の自分が思っているより、"
  },
  {
    "start": 157.58,
    "end": 159.14,
    "text": "案外その場で考えられる。"
  },
  {
    "start": 159.56,
    "end": 161.2,
    "text": "かつ回収の言葉は、"
  },
  {
    "start": 161.42,
    "end": 163.3,
    "text": "そんな小さな信頼を、"
  },
  {
    "start": 163.42,
    "end": 165.82,
    "text": "静かに思い出させてくれるのかもしれません。"
  }
]